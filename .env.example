# Copy to .env (gitignored) and adjust. Docker Compose reads .env automatically.
#   cp .env.example .env

# Host port for the web UI. ThreatLens is always bound to 127.0.0.1 (this machine
# only); this just picks the port. Use another value if 8080 is already in use.
TL_HOST_PORT=8080

# Optional first-run admin password (at least 12 characters). Only used when the
# database has no users yet. Leave empty to get a random password printed once in
# `docker compose logs threatlens`. Analysts are created from Settings, not here.
TL_ADMIN_PASSWORD=
